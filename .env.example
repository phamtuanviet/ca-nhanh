# Sao chép thành .env.local rồi điền giá trị. Với Supabase cục bộ: `npm run db:start && npm run env:local`.
# Biến có tiền tố NEXT_PUBLIC_ lộ ra trình duyệt; các biến còn lại chỉ dùng ở server.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Ký QR chấm công và webhook thanh toán: `openssl rand -base64 32`
QR_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Tài khoản nhận tiền nạp ví (VietQR)
PLATFORM_BANK_BIN=970436
PLATFORM_BANK_ACCOUNT=0011000000000
PLATFORM_BANK_NAME="CA NHANH DEMO"

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chế độ demo: hiện nút đăng nhập nhanh, công cụ demo. DEMO_PASSWORD là mật khẩu chung của tài khoản demo do `npm run seed` tạo.
DEMO_MODE=true
DEMO_PASSWORD=
